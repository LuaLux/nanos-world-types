-- Floating point Quaternion that can represent a rotation about an axis in 3-D space
declare class Quat
    constructor(X: number?, Y: number?, Z: number?, W: number?)
    -- The quaternion's X-component
    X: number
    -- The quaternion's Y-component
    Y: number
    -- The quaternion's Z-component
    Z: number
    -- The quaternion's W-component
    W: number
    -- In place normalize this Quaternion
    function Normalize(): nil
    -- Get the Rotator representation of this Quaternion
    function Rotator(): Rotator
    -- Returns the inverse of this Quaternion
    function Inverse(): Quat
    -- Rotates a vector by this Quaternion
    function RotateVector(vector: Vector): Vector
    -- Unrotates a vector by this Quaternion
    function UnrotateVector(vector: Vector): Vector
    -- Get the forward direction vector from this Quaternion
    function GetForwardVector(): Vector
    -- Get the right direction vector from this Quaternion
    function GetRightVector(): Vector
    -- Get the up direction vector from this Quaternion
    function GetUpVector(): Vector
    operator + (rhs: Quat | number): Quat
    operator - (rhs: Quat | number): Quat
    operator * (rhs: Quat | number): Quat
end

-- A container for rotation information (Pitch, Yaw, Roll). All rotation values are stored in degrees.
declare class Rotator
    constructor(pitch: number?, yaw: number?, roll: number?)
    -- Rotation around the right axis (around Y axis), Looking up and down (0=Straight Ahead, +Up, -Down)
    Pitch: number
    -- Rotation around the up axis (around Z axis), Running in circles 0=East, +North, -South.
    Yaw: number
    -- Rotation around the forward axis (around X axis), Tilting your head, 0=Straight, +Clockwise, -CCW.
    Roll: number
    -- Get the forward (X) unit direction vector from this component, in world space.
    function GetForwardVector(): Vector
    -- Get the right (Y) unit direction vector from this component, in world space.
    function GetRightVector(): Vector
    -- Get the up (Z) unit direction vector from this component, in world space.
    function GetUpVector(): Vector
    -- Rotate a vector rotated by this rotator.
    function RotateVector(vector: Vector): Vector
    -- In-place normalize, removes all winding and creates the “shortest route” rotation.
    function Normalize(): nil
    -- Returns the vector rotated by the inverse of this rotator.
    function UnrotateVector(vector: Vector): Vector
    -- Get Rotation as a quaternion.
    function Quaternion(): Quat
    -- Returns a new Rotator normalized.
    function GetNormalized(): Rotator
    -- Checks whether rotator is near to zero within a specified tolerance
    function IsNearlyZero(tolerance: number?): boolean
    -- Checks whether all components of the rotator are exactly zero
    function IsZero(): boolean
    -- Generates a random rotation, with optional random roll
    static function Random(roll: boolean?, min: number?, max: number?): Rotator
    operator + (rhs: Rotator | number): Rotator
    operator - (rhs: Rotator | number): Rotator
    operator * (rhs: Rotator | number): Rotator
end

-- A Vector composed of components (X, Y, Z) with floating point precision. Used mainly for entity position.
declare class Vector
    constructor(X: number?, Y: number?, Z: number?)
    -- X Coordinate
    X: number
    -- Y Coordinate
    Y: number
    -- Z Coordinate
    Z: number
    -- Check against another vector for equality, within specified error limits
    function Equals(other: Vector, tolerance: number?): boolean
    -- Distance between two points
    function Distance(other: Vector): number
    -- Squared distance between two points
    function DistanceSquared(other: Vector): number
    -- Calculates normalized version of vector without checking for zero length
    function GetUnsafeNormal(): Vector
    -- Gets a normalized copy of the vector, checking it is safe to do so based on the length
    function GetSafeNormal(): Vector
    -- Efficiently checks whether vector is near to another vector within a specified radius
    function IsNear(other: Vector, radius: number): boolean
    -- Checks whether vector is near to zero within a specified tolerance
    function IsNearlyZero(tolerance: number?): boolean
    -- Checks whether all components of the vector are exactly zero
    function IsZero(): boolean
    -- Normalize this vector in-place if it is larger than a given tolerance. Leaves it unchanged if not
    function Normalize(): boolean
    -- Get the length (magnitude) of this vector
    function Size(): number
    -- Get the squared length of this vector
    function SizeSquared(): number
    -- Return the Rotator orientation corresponding to the direction in which the vector points
    function ToOrientationRotator(): Rotator
    -- Return the Quaternion orientation corresponding to the direction in which the vector points
    function ToOrientationQuat(): Quat
    -- Dot product of two vectors
    function Dot(other: Vector): number
    -- Cross product of two vectors
    function Cross(other: Vector): Vector
    operator + (rhs: Vector | number): Vector
    operator - (rhs: Vector | number): Vector
    operator * (rhs: Vector | number): Vector
    operator / (rhs: Vector | number): Vector
    operator ^ (rhs: Vector | number): Vector
end

