    function ToHex(appends_transparency: boolean?): string
    -- Returns a random color from Color Palette
    static function RandomPalette(includes_black: boolean?): Color
    -- Returns a random color from all color scope
    static function Random(): Color
    -- Returns the color from 0-255 range values
    static function FromRGBA(r: number?, g: number?, b: number?, a: number?): Color
    -- Returns a color from the CYMK format
    static function FromCYMK(c: number?, y: number?, m: number?, k: number?, a: number?): Color
    -- Returns a color from the HSL format
    static function FromHSL(h: number?, s: number?, l: number?): Color
    -- Returns a color from the HSV format
    static function FromHSV(h: number?, s: number?, v: number?): Color
    -- Returns a color from the Hexadecimal format
    static function FromHEX(hex: string): Color
    -- Adds two Colors or a number into each component
    operator + (rhs: Color | number): Color
    -- Subtracts two Colors or a number from each component
    operator - (rhs: Color | number): Color
    -- Multiplies two Colors or a number into each component
    operator * (rhs: Color | number): Color
    -- Divides two Colors or a number from each component
    operator / (rhs: Color | number): Color
    -- Checks if two Colors have the same values
    operator == (rhs: Color): boolean
end

