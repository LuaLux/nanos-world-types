    static BLACK: any
    static TRANSPARENT: any
    static RED: any
    static GREEN: any
    static BLUE: any
    static YELLOW: any
    static CYAN: any
    static MAGENTA: any
    static ORANGE: any
    static CHARTREUSE: any
    static AQUAMARINE: any
    static AZURE: any
    static VIOLET: any
    static ROSE: any
